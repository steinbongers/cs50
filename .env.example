# Kopieer naar .env.local en vul de waarden in. Nooit committen.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) of de legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) of de legacy service_role key. ALLEEN server-side.
SUPABASE_SECRET_KEY=

# --- App --------------------------------------------------------------------
# Publieke URL van de app (voor auth-redirects), bv. http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Kommagescheiden e-mailadressen die /admin mogen zien
ADMIN_EMAILS=
# Gesloten pilot: registreren alleen met uitnodigingscode (standaard aan zodra SUPABASE_SECRET_KEY is gezet)
REQUIRE_INVITE_CODE=true
# Geheim voor de cron-route (Vercel Cron stuurt dit als Bearer-token)
CRON_SECRET=

# --- Enable Banking -----------------------------------------------------------
# Application ID uit het Enable Banking control panel (wordt de JWT 'kid')
ENABLE_BANKING_APP_ID=
# PEM private key van de applicatie, newlines als \n
ENABLE_BANKING_PRIVATE_KEY=
# Optioneel: andere API-basis (sandbox of lokale nabootsing). Standaard https://api.enablebanking.com
ENABLE_BANKING_API_URL=

# --- Web push -------------------------------------------------------------------
# Maak een sleutelpaar met: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jij@voorbeeld.nl

# --- Seed-script (alleen lokaal) -------------------------------------------
SEED_EMAIL=test@example.com
SEED_PASSWORD=test-wachtwoord-1234
