# Kopieer naar .env.local en vul de waarden in. Nooit committen.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) of de legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) of de legacy service_role key. ALLEEN server-side.
SUPABASE_SECRET_KEY=

# --- App --------------------------------------------------------------------
# Publieke URL van de app (voor auth-redirects), bv. http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Kommagescheiden e-mailadressen die /admin mogen zien
ADMIN_EMAILS=
# Geheim voor de cron-route (Vercel Cron stuurt dit als Bearer-token)
CRON_SECRET=

# --- Enable Banking (fase 3) -----------------------------------------------
ENABLE_BANKING_APP_ID=
# PEM private key, newlines als \n
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_REDIRECT_URL=

# --- Web push (fase 4) -----------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Seed-script (alleen lokaal) -------------------------------------------
SEED_EMAIL=test@example.com
SEED_PASSWORD=test-wachtwoord-1234
